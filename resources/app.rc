#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "version.h"

// 图标资源固定用数字 1，与托盘图标加载 (MAKEINTRESOURCEW(1)) 对应
1 ICON "app_icon.ico"
// 24 = RT_MANIFEST：启用 Common Controls v6 视觉样式（功德簿表格需要）
1 24 "app.manifest"

IDR_FISH   RCDATA "images/muyu.png"
IDR_GU     RCDATA "images/gu.png"
IDR_KNOCK  RCDATA "sounds/knock.mp3"
// 禅定背景音（均为 Kevin MacLeod, incompetech.com, CC-BY 4.0）：
// zen1 Meditation Impromptu 01 / zen2 Fresh Air / zen3 Kalimba Relaxation Music
// zen4 River Flute / zen5 White Lotus
IDR_ZEN1   RCDATA "audio/zen1.mp3"
IDR_ZEN2   RCDATA "audio/zen2.mp3"
IDR_ZEN3   RCDATA "audio/zen3.mp3"
IDR_ZEN4   RCDATA "audio/zen4.mp3"
IDR_ZEN5   RCDATA "audio/zen5.mp3"
// zen6 大悲咒（印能法师版，全网流传最广的完整版）：录音取自佛音网(foyinwang.com)免费流通版本，无明确授权声明（用户知悉并指定使用），如需商用请替换
IDR_ZEN6   RCDATA "audio/zen6.mp3"
// 达成佛光: 本地 AI 生成的金色光线(黑底，运行时按亮度转透明)，无第三方版权
IDR_GLOW   RCDATA "images/glow.png"

// 菜单 owner-draw 图标：Lucide 图标库 (ISC 许可) 经 Iconify API 以 #303030 渲染为 48px PNG
"ic_eye"              RCDATA "menu_icons/eye.png"
"ic_eye-off"          RCDATA "menu_icons/eye-off.png"
"ic_pin"              RCDATA "menu_icons/pin.png"
"ic_lock"             RCDATA "menu_icons/lock.png"
"ic_calendar-clock"   RCDATA "menu_icons/calendar-clock.png"
"ic_scaling"          RCDATA "menu_icons/scaling.png"
"ic_shrink"           RCDATA "menu_icons/shrink.png"
"ic_expand"           RCDATA "menu_icons/expand.png"
"ic_maximize"         RCDATA "menu_icons/maximize.png"
"ic_bot"              RCDATA "menu_icons/bot.png"
"ic_ban"              RCDATA "menu_icons/ban.png"
"ic_turtle"           RCDATA "menu_icons/turtle.png"
"ic_footprints"       RCDATA "menu_icons/footprints.png"
"ic_rabbit"           RCDATA "menu_icons/rabbit.png"
"ic_volume-x"         RCDATA "menu_icons/volume-x.png"
"ic_volume-1"         RCDATA "menu_icons/volume-1.png"
"ic_volume"           RCDATA "menu_icons/volume.png"
"ic_volume-2"         RCDATA "menu_icons/volume-2.png"
"ic_type"             RCDATA "menu_icons/type.png"
"ic_shuffle"          RCDATA "menu_icons/shuffle.png"
"ic_circle-slash"     RCDATA "menu_icons/circle-slash.png"
"ic_target"           RCDATA "menu_icons/target.png"
"ic_pencil-line"      RCDATA "menu_icons/pencil-line.png"
"ic_palette"          RCDATA "menu_icons/palette.png"
"ic_tree-deciduous"   RCDATA "menu_icons/tree-deciduous.png"
"ic_crown"            RCDATA "menu_icons/crown.png"
"ic_brush"            RCDATA "menu_icons/brush.png"
"ic_zap"              RCDATA "menu_icons/zap.png"
"ic_music"            RCDATA "menu_icons/music.png"
"ic_piano"            RCDATA "menu_icons/piano.png"
"ic_music-2"          RCDATA "menu_icons/music-2.png"
"ic_hand-metal"       RCDATA "menu_icons/hand-metal.png"
"ic_wind"             RCDATA "menu_icons/wind.png"
"ic_flower-2"         RCDATA "menu_icons/flower-2.png"
"ic_scroll-text"      RCDATA "menu_icons/scroll-text.png"
"ic_file-audio"       RCDATA "menu_icons/file-audio.png"
"ic_moon-star"        RCDATA "menu_icons/moon-star.png"
"ic_timer"            RCDATA "menu_icons/timer.png"
"ic_book-open"        RCDATA "menu_icons/book-open.png"
"ic_rotate-ccw"       RCDATA "menu_icons/rotate-ccw.png"
"ic_info"             RCDATA "menu_icons/info.png"
"ic_log-out"          RCDATA "menu_icons/log-out.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MUYU_VERSION_MAJOR,MUYU_VERSION_MINOR,MUYU_VERSION_PATCH,0
 PRODUCTVERSION MUYU_VERSION_MAJOR,MUYU_VERSION_MINOR,MUYU_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "电子木鱼"
            VALUE "InternalName", "电子木鱼"
            VALUE "OriginalFilename", "电子木鱼.exe"
            VALUE "ProductName", "Windows 桌面电子木鱼"
            VALUE "ProductVersion", MUYU_VERSION_STR
            VALUE "FileVersion", MUYU_VERSION_STR
            VALUE "CompanyName", "TianYunCode"
            VALUE "LegalCopyright", "Copyright © 2026 TianYunCode"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
